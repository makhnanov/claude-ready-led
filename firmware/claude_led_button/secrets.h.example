#pragma once

// Скопируй в secrets.h и впиши свои данные
// Данные твоей WiFi-сети (2.4 GHz, ESP8266 не умеет 5 GHz).
// Это та же сеть, в которой живёт основная плата.
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Адрес основной платы со светодиодом. Можно двумя способами:
//   IP        — "192.168.1.3", срабатывает сразу, без резолва (быстрее)
//   mDNS-имя  — "claude-led.local", не зависит от выданного роутером адреса
// Под IP стоит зарезервировать адрес в DHCP роутера, тогда он не уедет.
#define TARGET_HOST "192.168.1.3"

// Запасной вариант, если TARGET_HOST не отвечает: имя основной платы.
// Должен совпадать с MDNS_HOSTNAME основной платы + ".local".
#define MDNS_FALLBACK "claude-led.local"

// Токен основной платы. Пустая строка = проверка выключена.
// Должен совпадать с API_TOKEN в secrets.h основной платы.
#define API_TOKEN ""
